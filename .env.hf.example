# Hugging Face Spaces 环境变量配置示例
# 在 Hugging Face Space -> Settings -> Secrets 中配置

# 必填：MCP 鉴权
MCP_TOKEN=replace-with-a-strong-random-token

# 建议：管理接口鉴权
PPLX_ADMIN_TOKEN=replace-with-a-strong-admin-token

# 必填：Token 池（推荐直接放 JSON 字符串，不需要持久卷）
# 注意：在 Secrets 中请保存为单行 JSON
PPLX_TOKEN_POOL_CONFIG={"heart_beat":{"enable":false},"fallback":{"fallback_to_auto":true},"incognito":{"enabled":true},"tokens":[{"id":"account1@example.com","csrf_token":"your-csrf-token-1","session_token":"your-session-token-1"}]}

# 可选：端口（HF Docker Space 默认 7860）
PORT=7860

# 可选：代理
# SOCKS_PROXY=socks5://127.0.0.1:1080
