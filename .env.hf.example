# Hugging Face Spaces 环境变量配置示例
# 将这些变量添加到 Hugging Face Space 的 Settings → Repository secrets

# MCP 认证令牌
MCP_TOKEN=sk-123456

# 管理员令牌（用于管理界面）
PPLX_ADMIN_TOKEN=your-admin-token-here

# Token 池配置（JSON 格式）
# 注意：在 Hugging Face Spaces 中，需要将整个 JSON 字符串作为 Secret
# 或者使用环境变量文件上传功能
PPLX_TOKEN_POOL_CONFIG={
  "heart_beat": {
    "enable": true,
    "question": "今天是几号？",
    "interval": 6,
    "tg_bot_token": "",
    "tg_chat_id": ""
  },
  "fallback": {
    "fallback_to_auto": true
  },
  "tokens": [
    {
      "id": "account1@example.com",
      "csrf_token": "your-csrf-token-1",
      "session_token": "your-session-token-1"
    }
  ]
}

# 端口配置（Hugging Face Spaces 默认使用 7860）
PORT=7860

# 代理配置（可选）
# SOCKS_PROXY=socks5://127.0.0.1:1080